arete 0.1
# runs-after: phase 30

fn worker(id: int, out: Channel<int>):      # OPEN(26): channel type and operations
    out.send(id * id)

let results: Channel<int> = Channel()
for i in 1..=3:
    spawn worker(i, results)                # lightweight task, no async keyword

var sum = 0
for _ in 1..=3:
    sum += results.recv()                   # blocks until a value arrives
print(sum)

