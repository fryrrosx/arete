# runs-after: phase 4

print(1 + 2 * 3)        # * binds tighter than +
print((1 + 2) * 3)
print(7 / 2)            # int / int is a float
print(7 // 2)           # floor division
print(-7 // 2)          # floors toward negative infinity
print(7 % 2)
print(-7 % 2)           # remainder takes the sign of the divisor
print(2 ** 10)
print(-5 + 2)
print(1.5 * 2)          # floats always print with a decimal point
print(10 - 3 - 2)       # left associative
print(2 ** 3 ** 2)      # right associative: 2 ** 9

# expected output:
# 7
# 9
# 3.5
# 3
# -4
# 1
# 1
# 1024
# -3
# 3.0
# 5
# 512
