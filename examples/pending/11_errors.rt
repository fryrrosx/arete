arete 0.1
# runs-after: phase 14

fn divide(a: int, b: int) -> int throws:
    if b == 0:
        throw Error("division by zero")
    return a // b

fn safe_divide(a: int, b: int) -> int:
    try:
        return divide(a, b)
    catch e:
        print("caught: " + e.message)
        return 0

print(safe_divide(10, 2))
print(safe_divide(1, 0))

