# runs-after: phase 5

let name = "Arete"          # type inferred: string, immutable
let year: int = 2026        # explicit annotation
var counter = 0             # mutable
counter = counter + 1
counter += 1
let big = 1_000_000         # underscores between digits

print(name)
print(year)
print(counter)
print(big)

