# runs-after: phase 7

fn make_counter() -> fn() -> int:
    var count = 0
    fn next() -> int:
        count += 1              # captures `count` by reference (phase 7 decision)
        return count
    return next

let counter = make_counter()
print(counter())
print(counter())

let double = fn(x: int) => x * 2        # a lambda: one expression after `=>`
print(double(21))

fn apply(f: fn(int) -> int, v: int) -> int:
    return f(v)

print(apply(fn(x) => x + 1, 9))         # the parameter type may be left out in a lambda

# expected output:
# 1
# 2
# 42
# 10
