# runs-after: phase 11

let name = 'Karim'
let year = 2026
print("Hi, {name}! Born around {year - 20}.")
print("braces: {{not code}}")
print('single "quotes" inside')
print("tab:\tend\nnew line")
print(name.len())               # OPEN(9): methods vs len()
print(name.upper())
print(name[0])                  # indexing gives a string of length 1
print(name[1..3])               # slice, end excluded: "ar"
print("a" + "b" * 3)            # OPEN(9): string repeat
print("Ar" in name)             # OPEN(9): substring test with `in`

