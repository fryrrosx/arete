arete 0.1
fn outer() -> bool:
    fn even(n: int) -> bool:
        if n == 0:
            return true
        return odd(n - 1)
    fn odd(n: int) -> bool:
        if n == 0:
            return false
        return even(n - 1)
    return even(10)
print(outer())
print(is_odd(7))
fn is_even(n: int) -> bool:
    return true if n == 0 else is_odd(n - 1)
fn is_odd(n: int) -> bool:
    return false if n == 0 else is_even(n - 1)
