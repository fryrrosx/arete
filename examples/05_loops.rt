# runs-after: phase 7

var i = 0
while i < 3:
    print(i)
    i += 1

for n in 0..3:          # 0..3 is 0, 1, 2 (the end is excluded)
    print(n * 10)

for n in 1..=3:         # ..= includes the end
    if n == 2:
        continue
    print(n)

var total = 0
for n in 0..100:
    if n == 5:
        break
    total += n
print(total)

