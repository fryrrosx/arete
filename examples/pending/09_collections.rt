# runs-after: phase 12

var nums: MutableList<int> = [3, 1, 2]   # the literal takes the type the context expects
nums.add(4)                         # only a MutableList has add/sort
print(nums)
print(nums.len())
print(nums[0])
nums.sort()
print(nums)

let ages = {"ann": 31, "bob": 25}   # Map<string, int>, iterates in insertion order
print(ages["ann"])
print("bob" in ages)
for (name, age) in ages:            # destructuring a Map entry
    print(name + " " + str(age))    # str() turns a value into its printed form

var tags: MutableSet<string> = Set()  # a set is always spelled with its name
tags.add("a")
tags.add("a")
print(tags.len())

let empty: List<int> = []
print(empty.len())

